<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\tray-icon.ico</ApplicationIcon>
    <!-- A tray app is idle almost all the time: a background GC thread buys nothing here, and
         ConserveMemory makes the GC compact (large object heap included) rather than leave freed
         space committed after one of the app's rare allocation bursts. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <!-- The runtime sizes the gen0 allocation budget from the CPU cache: on a large desktop CPU
         that let ~48 MB of garbage (and every finalizable handle with it) pile up before the first
         collection, which an app allocating a few hundred KB a minute takes hours to reach — and
         the memory stays committed afterwards. 4 MB keeps collections tiny and the footprint flat. -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="4194304" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <!-- Transitive dep of Avalonia.Desktop's Linux tray support; 0.21.2 had a known
         high-severity D-Bus vuln (GHSA-xrw6-gwf8-vvr9); stay on the patched line or newer. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HaDesktop.Core\HaDesktop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\Strings\*.json" />
  </ItemGroup>
</Project>
